# Where the shop's SERVER reaches the gateway. The browser never talks to the gateway: it calls this
# app's own /api routes, which hold the session cookies and add the token. Not a NEXT_PUBLIC_ value.
GATEWAY_URL=http://localhost:8000
# Only the end-to-end tests read this one (they go straight to the gateway to set things up).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3200
